<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:id="@+id/connectionServerRelativeLayout" >
        <TextView
            android:text="@string/fuwuqiip"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textView1" />
        <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/ipEditText"
            android:layout_below="@id/textView1"
            android:inputType="text" />
        <TextView
            android:text="@string/duankou"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textView2"
            android:layout_below="@id/ipEditText"/>
        <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/portEditText"
            android:layout_below="@id/textView2"
            android:inputType="text" />
        <Button
            android:text="@string/lianjiefuwuqi"
            android:layout_width="@dimen/dp170"
            android:layout_height="wrap_content"
            android:id="@+id/connectionButton" 
            android:layout_below="@id/portEditText"/>
           <TextView
            android:text="@string/yonghuming"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"  
            android:id="@+id/textView3"
            android:layout_below="@id/connectionButton"
            android:enabled="false"/>
        <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/accountUserNameEditText"
            android:layout_below="@id/textView3"
            android:inputType="text" 
            android:enabled="false"/>
         <TextView
            android:text="@string/mima"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textView4"
            android:layout_below="@id/accountUserNameEditText"
            android:enabled="false"/>
        <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/accountPasswordEditText"
            android:layout_below="@id/textView4"
            android:inputType="textPassword"
            android:enabled="false"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp49"
            android:checked="false"
            android:text="@string/shiyongzhanghudenglu"
            android:id="@+id/accountCheck"
            android:layout_toRightOf="@id/connectionButton"
            android:layout_below="@id/portEditText"/>
        <TextView
            android:text=""
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/sp30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/stateTextView" 
            android:layout_below="@id/accountPasswordEditText"/>
        <TextView
             android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountTextView"
            android:textSize="@dimen/dp18"
            android:text="@string/zhucezhanghu"/>
        <TextView
            android:layout_marginRight="@dimen/abc_action_bar_stacked_max_height"
             android:layout_alignParentBottom="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chatRecordsTextView"
            android:textSize="@dimen/dp18"
            android:text="@string/xiaoxijilu"
            android:layout_toLeftOf="@id/activateAccountTextView"/>
        <TextView
             android:layout_alignParentBottom="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/guanyu"
            android:textSize="@dimen/dp18"
            android:text="@string/guanyu"/>
    </RelativeLayout>
    <RelativeLayout
       android:layout_width="match_parent"
        android:layout_height="match_parent"
         android:visibility="gone"
        android:id="@+id/chatRelativeLayout" >
        <HorizontalScrollView
            android:layout_width="match_parent"
           android:layout_height="@dimen/dp40"
            android:id="@+id/topScrollView" 
            android:layout_alignParentTop="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
             <Button
            android:text="@string/dangqiankehuduanshuliang"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp40"
            android:id="@+id/clientNumButton" />
        <Button
            android:text="@string/OldChatShuaXin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp40"
            android:id="@+id/oldChatButton" 
            android:layout_toRightOf="@id/clientNumButton"/>
                <EditText
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/privateSendEditText"
                    android:inputType="text"
                    android:text="@用户名1@用户名2..."
                    android:layout_toRightOf="@id/oldChatButton"
                    android:textSize="14sp"
                    android:textColor="#ff696969" />

            </LinearLayout>                
        </HorizontalScrollView>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/scrollViewMessageBox" 
             android:layout_above="@id/sendChatBox"
            android:layout_below="@id/topScrollView"
            android:overScrollMode="never">        
        <TextView
            android:text=""
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp18"
            android:id="@+id/messageBox"
            android:padding="@dimen/dp6"
            android:scrollbars="vertical"         
            android:verticalScrollbarPosition="right"
            android:scrollbarSize="@dimen/dp6"
            android:layout_above="@id/sendChatBox"/>
        </ScrollView>        
         
        <EditText
            android:text=""
            android:layout_width="@dimen/dp304"
            android:layout_height="wrap_content"
            android:id="@+id/sendChatBox"
            android:textSize="@dimen/sp22"
            android:layout_alignParentBottom="true"
            android:background="@drawable/edit_background"
            android:layout_marginBottom="@dimen/dp5"
            android:inputType="text" />
        <Button
            android:text="@string/fasong"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp40"
            android:layout_toRightOf="@id/sendChatBox"
            android:id="@+id/sendChatButton" 
             android:layout_alignParentBottom="true"/>
    </RelativeLayout><!--聊天布局-->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:id="@+id/activateAccountRelativeLayout" >
        <TextView
            android:text="@string/zhanghujihuoid"
           android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textView5" />
         <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountRelativeLayout_ActivateAccountIdEditText"
            android:layout_below="@id/textView5"
            android:inputType="text" />
         <TextView
            android:text="@string/yonghuming"
           android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:layout_below="@id/activateAccountRelativeLayout_ActivateAccountIdEditText"
            android:id="@+id/textView6" />
                 <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountRelativeLayout_ActivateAccountUserNameEditText"
            android:layout_below="@id/textView6"
            android:inputType="text" />
        <TextView
            android:text="@string/mima"
           android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:layout_below="@id/activateAccountRelativeLayout_ActivateAccountUserNameEditText"
            android:id="@+id/textView7" />
        <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountRelativeLayout_ActivateAccountPasswordEditText"
            android:layout_below="@id/textView7"
            android:inputType="textPassword" />
         <TextView
            android:text="@string/querenmima"
           android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:layout_below="@id/activateAccountRelativeLayout_ActivateAccountPasswordEditText"
            android:id="@+id/textView8" />
        <EditText
            android:layout_width="@dimen/dp340"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountRelativeLayout_ActivateAccountPassword2EditText"
            android:layout_below="@id/textView8"
            android:inputType="textPassword" />
        <Button
            android:text="@string/zhucezhanghu"
            android:layout_width="@dimen/dp140"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountRelativeLayout_ActivateAccountButton" 
            android:layout_below="@id/activateAccountRelativeLayout_ActivateAccountPassword2EditText"/>
     <TextView
            android:text=""
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/sp30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/activateAccountRelativeLayout_stateTextView" 
            android:layout_below="@id/activateAccountRelativeLayout_ActivateAccountButton"/>
    </RelativeLayout><!--注册账户布局-->
    <RelativeLayout
         android:visibility="gone"
  android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/chatRecordsRelativeLayout" >
        <Button
            android:text="@string/qingchuliaotianjilu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chatRecords_clearButton" />
          <Button
            android:text="@string/fanhui"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:id="@+id/chatRecords_exitButton" />
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/chatRecords_scrollViewMessageBox" 
            android:layout_below="@id/chatRecords_clearButton"
            android:overScrollMode="never">        
        <TextView
            android:text=""
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp18"
            android:id="@+id/chatRecords_messageBox"
            android:padding="@dimen/dp6"
            android:scrollbars="vertical"         
            android:verticalScrollbarPosition="right"
            android:scrollbarSize="@dimen/dp6"/>
        </ScrollView>    
    </RelativeLayout><!--消息记录布局-->
</RelativeLayout>